{
	"name": "companion-surface-prehkeytec-keyboard",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-surface-prehkeytec-keyboard.git"
	},
	"bugs": {
		"url": "https://github.com/bitfocus/companion-surface-prehkeytec-keyboard/issues"
	},
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && run build:main && run build:manifest-usb-ids",
		"build:main": "tsc -p tsconfig.build.json",
		"build:manifest-usb-ids": "node tools/update-usb-ids.mjs",
		"dev": "tsc -p tsconfig.build.json --watch",
		"format": "prettier -w .",
		"inspect:layouts": "node tools/inspect-mwf-layouts.mjs",
		"lint": "run build:main && eslint .",
		"package": "run build && companion-surface-build",
		"capture:poskey": "node tools/capture-poskey.mjs",
		"probe:hid": "node tools/list-hid.mjs",
		"test": "run build:main && node --test test/*.test.mjs",
		"verify:poskeys": "node tools/verify-poskeys.mjs"
	},
	"engines": {
		"node": "^22.21 || ^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-surface/base": "~1.3.0",
		"node-hid": "^3.4.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^22.20.1",
		"eslint": "^10.6.0",
		"prettier": "^3.9.5",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.63.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.1"
}
